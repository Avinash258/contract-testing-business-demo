    "/api/proxy/CEM/contracts/ct-00/engagement-context": {
      "get": {
        "tags": [
          "Service CEM — Client Engagement",
          "Contracts CT-01…CT-17"
        ],
        "summary": "CT-00: Engagement / project / job context",
        "description": "**downstream** contract · Producer **CEM** → Consumer **MAD**",
        "operationId": "CT_00",
        "responses": {
          "200": {
            "description": "Contract payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "contractId": "CT-00",
                  "engagementId": "ENG-2025-1065-001",
                  "clientId": "CLI-NV-TAX-01",
                  "projectId": "PRJ-ALPHA-1065-2025",
                  "entityGroupId": "EG-ALPHA",
                  "jobId": "JOB-TY2025-001",
                  "taxYear": 2025,
                  "formType": "1065",
                  "dueDate": "2026-03-15"
                }
              }
            }
          }
        }
      }
    },
