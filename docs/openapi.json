    "/api/filing/upload/cem": {
      "post": {
        "tags": [
          "Filing — Form 1065"
        ],
        "summary": "Upload CEM engagement Excel (.xlsx)",
        "operationId": "uploadCemExcel",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported CEM context"
          },
          "400": {
            "description": "Parse/validation error"
          }
        }
      }
    },
    "/api/filing/upload/mad": {
      "post": {
        "tags": [
          "Filing — Form 1065"
        ],
        "summary": "Upload MAD master-data Excel (.xlsx)",
        "operationId": "uploadMadExcel",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported entity + partners"
          },
          "400": {
            "description": "Parse/validation error"
          }
        }
      }
    },
    "/api/filing/upload/cam": {
      "post": {
        "tags": [
          "Filing — Form 1065"
        ],
        "summary": "Upload CAM trial-balance Excel (.xlsx)",
        "operationId": "uploadCamExcel",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported trial balance"
          },
          "400": {
            "description": "Parse/validation error"
          }
        }
      }
