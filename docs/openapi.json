{
  "openapi": "3.0.3",
  "info": {
    "title": "TaxMesh — Tax Demo Microservice APIs",
    "version": "1.0.0",
    "description": "Partnership tax pipeline demo for the NV AI-driven Contract Testing case study.\n\n**Microservices (separate processes):** CEM · MAD · CAM · TIM · RPAM · Forms Print\n\n**Contracts:** CT-00 … CT-17\n\nGateway proxies under `/api/proxy/{CEM|MAD|CAM|TIM|RPAM|FORMS}/...`.\nExcel uploads are owned by CEM / MAD / CAM microservices (`POST /upload`).",
    "contact": {
      "name": "TaxMesh Demo"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4100",
      "description": "Local gateway"
    },
    {
      "url": "http://localhost:4100",
      "description": "Localhost alias"
    }
  ],
  "tags": [
    {
      "name": "Gateway",
      "description": "Aggregation & catalog APIs"
    },
    {
      "name": "Filing — Form 1065",
      "description": "US partnership filing journey: CEM → MAD → CAM → TIM → RPAM → ERE/Forms Print → MeF (case study)"
    },
    {
      "name": "Contracts CT-01…CT-17",
      "description": "Producer contract payloads"
    },
    {
      "name": "Service CEM — Client Engagement",
      "description": "CEM · Engagement, project, entity group & job context · port 4101"
    },
    {
      "name": "Service MAD — Master Data",
      "description": "MAD · Legal entities, ownership, SALT & contacts · port 4102"
    },
    {
      "name": "Service CAM — Accounting",
      "description": "CAM · Chart of accounts, mappings & adjustments · port 4103"
    },
    {
      "name": "Service TIM — Tax Engine",
      "description": "TIM · Forms import, federal / state recalculation · port 4104"
    },
    {
      "name": "Service RPAM — Allocations",
      "description": "RPAM · Partner capital, allocate & tier · port 4105"
    },
    {
      "name": "Service FORMS — Forms & Print",
      "description": "Forms Print · Reporting sync & final print package · port 4106"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Gateway"
        ],
        "summary": "Gateway + all service health",
        "operationId": "getGatewayHealth",
        "responses": {
          "200": {
            "description": "Health snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/architecture": {
      "get": {
        "tags": [
          "Gateway"
        ],
        "summary": "Architecture catalog (services, contracts, matrix)",
        "operationId": "getArchitecture",
        "responses": {
          "200": {
            "description": "Architecture document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/contracts/{id}": {
      "get": {
        "tags": [
          "Gateway"
        ],
        "summary": "Contract metadata + sample payload",
        "operationId": "getContractById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "CT-01"
            },
            "description": "Contract id CT-01 … CT-17"
          }
        ],
        "responses": {
          "200": {
            "description": "Contract detail"
          },
          "404": {
            "description": "Unknown contract"
          }
        }
      }
    },
    "/api/filing": {
      "get": {
        "tags": [
          "Filing — Form 1065"
        ],
        "summary": "Engagement filing snapshot (CEM→Forms journey)",
        "operationId": "getFiling",
        "responses": {
          "200": {
            "description": "Full engagement + steps + gates"
          }
        }
      }
    },
    "/api/filing/reset": {
      "post": {
        "tags": [
          "Filing — Form 1065"
        ],
        "summary": "Reset demo engagement to draft",
        "operationId": "resetFiling",
        "responses": {
          "200": {
            "description": "Fresh snapshot"
          }
        }
      }
    },
    "/api/filing/run/{stepId}": {
      "post": {
        "tags": [
          "Filing — Form 1065"
        ],
        "summary": "Run one filing stage (cem|setup|books|tax|allocate|forms|efile)",
        "operationId": "runFilingStep",
        "parameters": [
          {
            "name": "stepId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "cem",
                "setup",
                "books",
                "tax",
                "allocate",
                "forms",
                "efile"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated snapshot"
          },
          "400": {
            "description": "Business rule / sequencing error"
          }
        }
      }
    },
    "/api/filing/run-all": {
      "post": {
        "tags": [
          "Filing — Form 1065"
        ],
        "summary": "Run full CEM→MAD→CAM→TIM→RPAM→Forms→MeF journey",
        "operationId": "runFilingAll",
        "responses": {
          "200": {
            "description": "Completed engagement snapshot"
          }
        }
      }
    },
